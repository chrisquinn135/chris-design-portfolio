		},
		{
			"src": "/assetmanager/",
			"status": 308,
			"headers": {
				"Location": "/assetmanager"
			}
		},
		{
			"src": "/designToken",
			"dest": "/designToken/"
		},
		{
			"src": "/designToken/",
			"status": 308,
			"headers": {
				"Location": "/designToken"
			}
		},
		{
			"src": "/sfds",
